# Reference backend config — copy to `.env` and fill in. NEVER commit `.env`.
# Run with:  node --env-file=.env src/index.js

# WebSocket signaling port
SIGNAL_PORT=8080

# --- iOS: APNs VoIP push (one .p8 key serves alert + voip) ---
APNS_P8=./AuthKey.p8          # path to your APNs auth key (.p8) — gitignored
APNS_KEY_ID=ABC123DEFG        # 10-char Key ID
APNS_TEAM_ID=FKL5JV5G7M       # 10-char Apple Team ID
APNS_BUNDLE_ID=ahoy.example   # the example app's bundle id (topic becomes <id>.voip)
APNS_HOST=sandbox             # sandbox = dev build | prod = TestFlight/App Store
                              # wrong host -> BadDeviceToken (silent non-delivery)

# --- Android: FCM HTTP v1 (service-account JSON, NOT the legacy server key) ---
FCM_SA_JSON=./service-account.json   # Firebase console -> Service accounts -> key
FCM_PROJECT_ID=react-native-ahoy-demo
