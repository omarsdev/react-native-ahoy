<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Self-managed Telecom: install-time permission. Telecom silently never
       binds AhoyConnectionService without it, and it is the access prerequisite
       for the phoneCall foreground-service type. -->
  <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
  <!-- Needed later for locked-screen ringing; auto-granted to calling apps on targetSdk 34+. -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <!-- So the incoming/ongoing call notifications are visible on API 33+. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- T6: the only official Doze knob. Policy-sensitive — fires the direct battery
       dialog (ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS); consumers ship a VoIP
       justification or use the settings-list intent instead. -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <!-- T6: re-arm the self-managed PhoneAccount after reboot (no FGS start from boot). -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <!-- System Telecom binds this; guarded so ONLY Telecom can bind it. -->
    <service
      android:name="dev.omars.ahoy.AhoyConnectionService"
      android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
      android:exported="true">
      <intent-filter>
        <action android:name="android.telecom.ConnectionService" />
      </intent-filter>
    </service>

    <!-- Keeps the active call alive; phoneCall is legal because we hold MANAGE_OWN_CALLS. -->
    <service
      android:name="dev.omars.ahoy.AhoyCallForegroundService"
      android:foregroundServiceType="phoneCall"
      android:exported="false" />

    <!-- T5: full-screen-intent target. Launched by the CallStyle notification's
         FSI on a locked/screen-off device; showWhenLocked + turnScreenOn make it
         ring over the keyguard and wake the screen. -->
    <activity
      android:name="dev.omars.ahoy.IncomingCallActivity"
      android:exported="false"
      android:showWhenLocked="true"
      android:turnScreenOn="true"
      android:excludeFromRecents="true"
      android:launchMode="singleInstance"
      android:taskAffinity=""
      android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

    <!-- Backs the Answer / Decline buttons on the incoming-call notification. -->
    <receiver
      android:name="dev.omars.ahoy.AhoyCallActionReceiver"
      android:exported="false" />

    <!-- T4: receives the high-priority data-only FCM call invite. -->
    <service
      android:name="dev.omars.ahoy.AhoyMessagingService"
      android:exported="false">
      <intent-filter>
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>

    <!-- T4: runs the AhoyIncomingCall Headless JS task while backgrounded/killed. -->
    <service
      android:name="dev.omars.ahoy.AhoyHeadlessTaskService"
      android:exported="false" />

    <!-- T6: re-register the self-managed PhoneAccount after reboot. -->
    <receiver
      android:name="dev.omars.ahoy.AhoyBootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
